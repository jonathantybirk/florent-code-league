# Replays (regenerated with fcode run)
*.replay26

# Python
__pycache__/
*.pyc

# Virtual environments
.venv/
venv/

# Tournament run directories. The durable artefacts -- what was planned and what happened --
# are manifest.json, matches.csv, ratings.csv and the compliance CSVs; everything else is
# reproducible from them
# plus the registry, and the bulk (staged bots, per-match JSONs, LSF logs) is large.
tournament/runs/*/stage/
tournament/runs/*/compliance-stage/
tournament/runs/*/maps/
tournament/runs/*/results/
tournament/runs/*/logs/
tournament/runs/*/replays/
tournament/runs/*/schedule.jsonl
tournament/runs/*/job.sh
tournament/runs/*/job_*.sh
tournament/runs/*/work_*.txt

# The archived pre-2.3.4 (leaderboard v1) runs keep the same shape; the automation and the
# rating pool glob tournament/runs/*/ and deliberately do not see this directory.
tournament/runs-v1/*/stage/
tournament/runs-v1/*/compliance-stage/
tournament/runs-v1/*/maps/
tournament/runs-v1/*/results/
tournament/runs-v1/*/logs/
tournament/runs-v1/*/replays/
tournament/runs-v1/*/schedule.jsonl
tournament/runs-v1/*/job.sh
tournament/runs-v1/*/job_*.sh
tournament/runs-v1/*/work_*.txt
tournament/automation-state.json
tournament/automation.lock

# Held-out evaluation maps. The README is tracked so the directory's purpose is documented;
# the maps themselves must never reach the repository -- see tournament/custom_maps/README.md.
tournament/custom_maps/*
!tournament/custom_maps/README.md

# Derived first-publication dates. Content-addressed, so it is a pure cache.
tournament/first-published.json

# Derived import verdicts. Content-addressed, so it is a pure cache.
tournament/unloadable.json

# Live ladder feed cache (append-only, rebuilt on demand from the platform API).
tournament/live-cache.jsonl
tournament/live-identity.json

# Per-match logs from tournament runs. matches-distinct.csv routinely exceeds
# GitHub's 100 MiB per-file hard limit -- 13 of them blocked every push to
# x/tournament for 70 commits until they were stripped from history on
# 2026-08-06. ratings.csv is the summary everything actually consumes and stays
# tracked; the raw per-match rows are regenerable from the run.
tournament/runs/*/matches-distinct.csv
tournament/runs-v1/*/matches-distinct.csv
